{
  "name": "deep-messenger-desktop",
  "version": "1.2.6",
  "deepVersionCode": 9,
  "description": "Deep Messenger for Windows",
  "main": "dist-electron/main.js",
  "author": "Deep Design",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "icons": "node scripts/generate-icon.mjs",
    "dist": "npm run icons && npm run build && electron-builder --win --publish never",
    "dist:portable": "npm run icons && npm run build && electron-builder --win portable --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "online.deepdesign.deep.desktop",
    "productName": "Deep Messenger",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "artifactName": "Deep-Messenger-Windows-Setup-latest.${ext}",
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/ArseniK10228/deep-messenger/releases/download/downloads"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "shortcutName": "Deep Messenger",
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "ru",
        "en"
      ],
      "language": "1049"
    },
    "portable": {
      "artifactName": "Deep-Messenger-Portable.exe"
    }
  }
}
