# Server
NODE_ENV=development
PORT=3002
HOST=0.0.0.0
JWT_SECRET=change-me-to-long-random-string
PUBLIC_URL=https://api.deepdesignpc.online

# PostgreSQL (docker compose defaults)
DATABASE_URL=postgres://deep:deep@localhost:5433/deep_messenger

# Firebase Admin — путь к service account JSON (скачать из Firebase Console)
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json

# Загрузки (фото, файлы, голосовые)
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=50
