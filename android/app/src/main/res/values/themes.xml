<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Deep" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/deep_bg</item>
        <item name="android:navigationBarColor">@color/deep_bg</item>
        <item name="android:windowBackground">@color/deep_bg</item>
    </style>

    <style name="Theme.Deep.Transparent" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
